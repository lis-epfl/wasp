[Unit]
Description=WASP control software (inside a tmux session)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=lis25
WorkingDirectory=/home/lis25/Documents/wasp
Environment=HOME=/home/lis25
ExecStart=/usr/bin/tmux -L wasp new-session -d -s wasp /bin/bash /home/lis25/Documents/wasp/utils/start_wasp.sh
ExecStop=-/usr/bin/tmux -L wasp kill-server
Restart=no

[Install]
WantedBy=multi-user.target
